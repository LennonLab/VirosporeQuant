# Extract fit3 coefficients
p <- coef(fit3_allmoi)
# Infection times for predicted curve
x.pred <- seq(0, 24, length.out = 1000)
# Predicted log10 virospore concentration
y.pred.log <- p["b0"] +
p["a"] *
ifelse(
x.pred <= p["mu"],
exp(-(x.pred - p["mu"])^2 /
(2 * p["sigmaL"]^2)),
exp(-(x.pred - p["mu"])^2 /
(2 * p["sigmaR"]^2))
)
# Convert predictions to original virospore scale
y.pred <- 10^y.pred.log
# Add fitted curve
lines(x.pred, y.pred,
col = "red",
lty = 1,
lwd = 3)
# Close plot device
dev.off()
graphics.off()
# Show plot
img <- readPNG("~/GitHub/VirosporeQuant/Optimal.entrap/Figures/fit3_allmoi.png")
grid.raster(img)
pars <- coef(fit3_allmoi)
mu <- pars["mu"]
sigmaL <- pars["sigmaL"]
sigmaR <- pars["sigmaR"]
left_half <- mu - sigmaL * sqrt(2 * log(2))
right_half <- mu + sigmaR * sqrt(2 * log(2))
window <- right_half - left_half
c(
optimum = mu,
window_start = left_half,
window_end = right_half,
window_width = window
)
# Extract fitted parameters
pars <- coef(fit3_allmoi)
mu <- pars["mu"]
sigmaL <- pars["sigmaL"]
sigmaR <- pars["sigmaR"]
# Define series of thresholds
thresholds <- seq(0.10, 0.90, by = 0.05)
sensitivity <- data.frame(
threshold = thresholds
) %>%
mutate(
window_start =
mu - sigmaL * sqrt(-2 * log(threshold)),
window_end =
mu + sigmaR * sqrt(-2 * log(threshold)),
window_width =
window_end - window_start
)
sensitivity
ggplot(
sensitivity,
aes(
x = threshold * 100,
y = window_width
)
) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
geom_vline(
xintercept = 50,
linetype = "dashed"
) +
labs(
x = "Threshold (% of maximum)",
y = "Estimated temporal window width (h)"
) +
theme_classic()
sensitivity_long <- sensitivity %>%
select(
threshold,
window_start,
window_end
) %>%
tidyr::pivot_longer(
cols = c(window_start, window_end),
names_to = "Boundary",
values_to = "Time"
)
ggplot(
sensitivity_long,
aes(
x = threshold * 100,
y = Time,
linetype = Boundary
)
) +
geom_line(linewidth = 1) +
geom_hline(
yintercept = mu,
linetype = "dotted"
) +
labs(
x = "Threshold (% of maximum)",
y = "Infection time (h)",
linetype = "Window boundary"
) +
theme_classic()
